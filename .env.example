# ── LLM Classification Providers ────────────────────────────────────
# Enable/disable each provider with true/false.
# If both are enabled, Groq is tried first; Gemini is the fallback.
# If neither is enabled, Tier 3 (LLM classification) is skipped.

GROQ_ENABLED=true
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_ENABLED=false
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── Debug & Dry Run ─────────────────────────────────────────────────
# Show extracted text, tier results, and LLM responses in API output
DEBUG_MODE=false
# Skip actual pipeline calls (useful for testing classification only)
PIPELINE_DRY_RUN=true

# ── Pipeline Endpoints ──────────────────────────────────────────────
OCR_ENDPOINT=http://ocr-service/process
LLM_ENDPOINT=http://llm-service/process
OCR_UI_URL=http://localhost:3001
LLM_UI_URL=http://localhost:8080

# ── PDF Trait Detection ─────────────────────────────────────────────
# Override settings.txt value via env var (optional)
# ENABLE_PDF_TRAITS=true

# NOTE: Classification tuning parameters (max pages, confidence, LLM
# temperature, timeouts, Docling formats) are configured in
# config/settings.txt — not here. Edit that file for non-secret settings.
