# ── LLM Classification Providers ────────────────────────────────────
# Enable/disable each provider with true/false.
# If both are enabled, Groq is tried first; Gemini is the fallback.
# If neither is enabled, Tier 3 (LLM classification) is skipped.

GROQ_ENABLED=true
GROQ_API_KEY=your-groq-api-key-here
GROQ_MODEL=llama-3.3-70b-versatile

GEMINI_ENABLED=false
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash

# ── Classification Settings ─────────────────────────────────────────
# Number of pages to extract text from for LLM classification (1-5)
CLASSIFICATION_MAX_PAGES=3
# Set to true to include extracted text, tier results, and LLM responses in API output
DEBUG_MODE=false

# ── Pipeline Endpoints ──────────────────────────────────────────────
# Set DRY_RUN to true to skip actual pipeline calls (useful for testing classification)
PIPELINE_DRY_RUN=true
OCR_ENDPOINT=http://ocr-service/process
LLM_ENDPOINT=http://llm-service/process
PIPELINE_TIMEOUT=30
